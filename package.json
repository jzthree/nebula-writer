{
  "name": "nebula-writer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "sidecar": "tsx server/index.ts",
    "sidecar:local-ai": "npm run sidecar",
    "sidecar:locked": "WRITER_ALLOW_CLI=0 npm run sidecar",
    "dev:all": "concurrently -k -n sidecar,web -c cyan,magenta \"npm run sidecar\" \"npm run dev\"",
    "dev:share": "concurrently -k -n sidecar,web -c cyan,magenta \"WRITER_HOST=0.0.0.0 npm run sidecar\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && node scripts/gdocs-build.mjs",
    "qa": "node scripts/qa-loop.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "build:cloudflare": "npm run build && cd cloudflare && npm ci",
    "setup": "bash scripts/setup.sh",
    "word:setup": "bash scripts/word-addin-setup.sh",
    "word:doctor": "node scripts/word-addin-doctor.mjs",
    "word:icons": "node scripts/word-addin-icons.mjs",
    "gdocs:build": "node scripts/gdocs-build.mjs",
    "gdocs:setup": "bash scripts/gdocs-setup.sh"
  },
  "dependencies": {
    "@tiptap/extension-collaboration": "^2.27.2",
    "@tiptap/extension-collaboration-cursor": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-paragraph": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.12.0",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.12.0",
    "@tiptap/starter-kit": "^2.12.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "docx": "^9.5.1",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "mathjax": "^4.1.2",
    "multer": "^2.1.1",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.3",
    "ws": "^8.21.0",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^5.0.0",
    "@types/google-apps-script": "^2.0.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/office-js": "^1.0.608",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^3.2.4"
  }
}
