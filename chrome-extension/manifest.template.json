{
  "manifest_version": 3,
  "name": "Nebula Writer for Google Docs",
  "version": "0.1.0",
  "description": "Writer's review pane beside your Google Doc — suggestions from the Codex and Claude CLIs running on your own machine.",
  "action": {
    "default_title": "Open Nebula Writer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["sidePanel", "identity", "tabs", "alarms", "scripting"],
  "optional_host_permissions": ["https://www.googleapis.com/*"],
  "host_permissions": [
    "https://docs.googleapis.com/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*",
    "__PANE_ORIGIN__/*"
  ],
  "oauth2": {
    "client_id": "__CLIENT_ID__",
    "scopes": ["https://www.googleapis.com/auth/documents"]
  }
}
